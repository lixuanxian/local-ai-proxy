{
  "name": "local-ai-proxy",
  "version": "1.0.1",
  "description": "A unified API proxy for multiple local AI clients",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server.js",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "build:icon": "node scripts/build-icon.js",
    "build:server": "node scripts/build-server.js",
    "setup": "npm install && cd web && npm install && npm run build",
    "dist": "node scripts/dist.js win",
    "dist:win": "node scripts/dist.js win",
    "dist:mac": "node scripts/dist.js mac",
    "dist:mac-arm64": "node scripts/dist.js mac-arm64",
    "dist:mac-x64": "node scripts/dist.js mac-x64",
    "dist:linux": "node scripts/dist.js linux",
    "dist:debug": "node scripts/dist.js win --skip-web --debug"
  },
  "pkg": {
    "outputPath": "dist",
    "assets": [
      "public/**/*",
      "assets/icon.ico",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.76",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "pe-library": "^2.0.1",
    "png-to-ico": "^2.1.8",
    "resedit": "^3.0.2",
    "sharp": "^0.33.5"
  }
}
